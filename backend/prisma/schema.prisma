generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ScopeLevel {
  GLOBAL
  DISTRICT
  UNION
  KILAI
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  isSystem    Boolean    @default(false)
  scopeLevel  ScopeLevel @default(GLOBAL)
  priority    Int        @default(0)
  
  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique
  description String?
  module      String?
  
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum DistrictGroupEnum {
  KURINJIPADI
  CUDDALORE
}

enum UnitTypeEnum {
  UNION
  TOWN
  TOWN_PANCHAYAT
  AREA
}

model User {
  id           String @id @default(uuid())
  userId       String @unique
  passwordHash String
  roleId       String?
  role         Role?  @relation(fields: [roleId], references: [id])

  cadreId   String? @unique
  cadre     Cadre?  @relation(fields: [cadreId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model District {
  id   String @id @default(uuid())
  name String @unique

  contactName  String?
  contactPhone String?
  contactEmail String?
  attachments  Json?
  translations Json?

  unions    Union[]
  cadres    Cadre[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Union {
  id   String @id @default(uuid())
  name String @unique

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  group    DistrictGroupEnum @default(KURINJIPADI)
  unitType UnitTypeEnum      @default(UNION)

  contactName  String?
  contactPhone String?
  contactEmail String?
  areasCovered String[]
  attachments  Json?
  translations Json?

  panchayats Panchayat[]
  kilais Kilai[]
  cadres Cadre[]
  booths Booth[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PanchayatType {
  VILLAGE_PANCHAYAT
  TOWN_PANCHAYAT_WARD
  MUNICIPALITY_WARD
}

model Panchayat {
  id           String        @id @default(uuid())
  name         String
  nameTa       String
  code         String?
  type         PanchayatType @default(VILLAGE_PANCHAYAT)
  wardNumber   Int?

  centerLat    Float?
  centerLng    Float?
  boundary     Json?
  description  String?
  translations Json?

  unionId      String
  union        Union         @relation(fields: [unionId], references: [id], onDelete: Cascade)

  villages     Village[]
  kilais       Kilai[]
  booths       Booth[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([unionId, name])
  @@index([unionId])
}

model Village {
  id          String    @id @default(uuid())
  name        String
  nameTa      String
  code        String?
  centerLat   Float?
  centerLng   Float?
  description String?

  panchayatId String
  panchayat   Panchayat @relation(fields: [panchayatId], references: [id], onDelete: Cascade)

  kilais      Kilai[]   @relation("KilaiVillages")
  booths      Booth[]   @relation("VillageBooths")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([panchayatId, name])
  @@index([panchayatId])
}

enum KilaiStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model Kilai {
  id             String      @id @default(uuid())
  name           String
  secretaryName  String?
  panchayat      String?
  description    String?
  translations   Json?
  villages       String[]
  address        String?
  pincode        String?
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  officePhotoUrl String?
  status         KilaiStatus @default(ACTIVE)
  healthScore    Int         @default(0)

  unionId String
  union   Union  @relation(fields: [unionId], references: [id])

  panchayatId  String?
  panchayatRel Panchayat? @relation(fields: [panchayatId], references: [id])
  villagesRel  Village[]  @relation("KilaiVillages")

  cadres        Cadre[]        @relation("KilaiCadres")
  officeBearers OfficeBearer[]

  booths Booth[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CadreLevel {
  DISTRICT
  GROUP
  UNION
  KILAI
}

model Cadre {
  id            String  @id @default(uuid())
  user          User?
  memberId      String  @unique
  name          String
  phone         String?
  aadhaarNumber String? @unique
  voterId       String? @unique
  photoUrl      String?
  attachments   Json?
  translations  Json?
  role          String?
  area          String?
  boothNo       String?

  level CadreLevel @default(KILAI)

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  districtGroup DistrictGroupEnum?

  unionId String?
  union   Union?  @relation(fields: [unionId], references: [id])

  homeKilaiId String?
  homeKilai   Kilai?  @relation("KilaiCadres", fields: [homeKilaiId], references: [id])

  wingId String?
  wing   Wing?   @relation(fields: [wingId], references: [id])

  officeBearerRoles OfficeBearer[]

  boothsAsAgent Booth[] @relation("BoothAgents")
  boothAgentAssignments BoothAgentAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wing {
  id        String  @id @default(uuid())
  name      String  @unique
  color     String?
  textColor String?
  iconName     String?
  order        Int     @default(0)
  priority     Int     @default(0)
  translations Json?

  cadres Cadre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OfficeBearerRole {
  SECRETARY
  PRESIDENT
  TREASURER
  DEPUTY_SECRETARY
  YOUTH_WING
  WOMEN_WING
  STUDENT_WING
  IT_WING
}

model OfficeBearer {
  id       String           @id @default(uuid())
  role     OfficeBearerRole
  status   KilaiStatus      @default(ACTIVE)
  joinedOn DateTime         @default(now())

  level CadreLevel @default(KILAI)

  kilaiId String?
  kilai   Kilai?  @relation(fields: [kilaiId], references: [id])

  cadreId String
  cadre   Cadre  @relation(fields: [cadreId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booth {
  id               String  @id @default(uuid())
  name             String
  boothNo          String  @unique
  translations     Json?
  area             String?
  maleCount        Int     @default(0)
  femaleCount      Int     @default(0)
  thirdGenderCount Int     @default(0)
  totalCount       Int     @default(0)

  unionId          String?
  union            Union?      @relation(fields: [unionId], references: [id])

  panchayatId      String?
  panchayatRel     Panchayat?  @relation(fields: [panchayatId], references: [id])

  villages         Village[]   @relation("VillageBooths")

  kilais Kilai[]
  agents Cadre[] @relation("BoothAgents")
  agentAssignments BoothAgentAssignment[]
  electionResults BoothElectionResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Election {
  id          String    @id @default(uuid())
  name        String
  nameTa      String?
  year        String    // e.g. "2026", "2024"
  type        String    @default("ASSEMBLY") // ASSEMBLY, PARLIAMENTARY, LOCAL_BODY, BY_ELECTION
  date        DateTime?
  isCurrent   Boolean   @default(false)
  status      String    @default("UPCOMING") // UPCOMING, ACTIVE, COMPLETED
  description String?

  electionResults   BoothElectionResult[]
  agentAssignments BoothAgentAssignment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([year, name])
  @@index([isCurrent])
}

model BoothAgentAssignment {
  id          String    @id @default(uuid())
  boothId     String
  booth       Booth     @relation(fields: [boothId], references: [id], onDelete: Cascade)

  cadreId     String
  cadre       Cadre     @relation(fields: [cadreId], references: [id], onDelete: Cascade)

  electionId  String
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  role        String?   // "Chief Agent", "Polling Agent", "Relief Agent"
  blaFormUrl  String?   // Uploaded BLA Form / Appointment Letter image
  notes       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([boothId, cadreId, electionId])
  @@index([boothId])
  @@index([cadreId])
  @@index([electionId])
}

model BoothElectionResult {
  id               String    @id @default(uuid())
  boothId          String
  booth            Booth     @relation(fields: [boothId], references: [id], onDelete: Cascade)

  electionId       String?
  election         Election? @relation(fields: [electionId], references: [id], onDelete: SetNull)

  electionYear     String   // e.g. "2024"
  electionName     String   // e.g. "2024 Parliament", "2021 Assembly"

  totalVotesPolled Int      @default(0)
  tvkVotes         Int      @default(0)
  tvkPercentage    Float    @default(0.0)

  topParty1Name    String?  // e.g. "DMK"
  topParty1Votes   Int      @default(0)

  topParty2Name    String?  // e.g. "AIADMK"
  topParty2Votes   Int      @default(0)

  winnerPartyName  String?  // e.g. "DMK" or "TVK"
  margin           Int?     // difference between #1 and #2
  notes            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([boothId, electionYear, electionName])
  @@index([boothId])
  @@index([electionId])
}
